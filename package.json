{
  "name": "bitinz",
  "version": "1.0.0",
  "description": "Compress JPG, PNG and WebP images and convert them to WebP with the Bitinz API, from the command line, from Node or from AI agents over MCP.",
  "keywords": [
    "image",
    "compression",
    "compress",
    "jpg",
    "jpeg",
    "png",
    "webp",
    "optimize",
    "cli",
    "mcp",
    "tinypng-alternative"
  ],
  "homepage": "https://bitinz.com/developers",
  "bugs": "https://github.com/bitinz/bitinz/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitinz/bitinz.git"
  },
  "license": "MIT",
  "author": "Bitinz <contact@bitinz.com>",
  "type": "module",
  "mcpName": "io.github.bitinz/bitinz",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "bitinz": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/version.mjs && rm -rf dist && tsc -p tsconfig.json && chmod 755 dist/cli.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.2"
  }
}
